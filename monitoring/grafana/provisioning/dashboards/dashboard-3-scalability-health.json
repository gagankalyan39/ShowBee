{
  "title": "SHOWBEE — 3. Scalability & System Health Observatory",
  "uid": "showbee-scalability-health",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "name": "K6 Stage Transitions",
        "type": "dashboard",
        "enable": true,
        "hide": false,
        "iconColor": "blue"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "📈 Request Rate (RPS) vs 2xx Throughput",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(showbee_http_requests_total[1m]))",
          "legendFormat": "Total Requests/s",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "expr": "sum(rate(showbee_http_requests_total{status_code=~\"2..\"}[1m]))",
          "legendFormat": "Successful (2xx) Throughput/s",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 2,
      "title": "⚠️ HTTP Error Rate (%)",
      "type": "gauge",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 8 },
      "targets": [
        {
          "expr": "clamp_max((sum(rate(showbee_http_errors_total[1m])) / (sum(rate(showbee_http_requests_total[1m])) + 0.0001)) * 100, 100)",
          "legendFormat": "Error Rate %",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": { "defaults": { "min": 0, "max": 100, "unit": "percent" } },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 3,
      "title": "🛡 Database Deadlocks (40P01 Counter)",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 8 },
      "targets": [
        {
          "expr": "sum(increase(showbee_db_deadlocks_total[1h]))",
          "legendFormat": "Deadlocks (Last 1h)",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" } } },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 4,
      "title": "⏱ End-to-End Latency Percentiles (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(showbee_http_request_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p50 Latency",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(showbee_http_request_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p95 Latency",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(showbee_http_request_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p99 Latency",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 5,
      "title": "🗄 DB Pool Saturation: Waiting Queue & Rollbacks",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(showbee_db_pool_waiting_count)",
          "legendFormat": "Waiting Queries",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "expr": "sum(rate(showbee_db_transaction_rollbacks_total[1m]))",
          "legendFormat": "Rollbacks / Sec",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 30,
      "title": "🚀 LIVE LOAD VU STAIRCASE",
      "type": "row",
      "gridPos": { "x": 0, "y": 40, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 31,
      "title": "👥 Active VU Count",
      "type": "stat",
      "gridPos": { "x": 0, "y": 41, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "sum(k6_vus)",
          "legendFormat": "Active VUs",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 1000 }
            ]
          },
          "custom": {
            "fontSize": 32
          },
          "noValue": "0"
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background"
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 32,
      "title": "🎯 Target VU Level",
      "type": "stat",
      "gridPos": { "x": 4, "y": 41, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "sum(k6_vus_max)",
          "legendFormat": "Target VUs",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "noValue": "0"
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 33,
      "title": "🏆 Peak VU Reached",
      "type": "stat",
      "gridPos": { "x": 8, "y": 41, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "max_over_time(sum(k6_vus)[15m:])",
          "legendFormat": "Peak VUs",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 2000 }
            ]
          },
          "noValue": "0"
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 34,
      "title": "📍 Current Stage (Total Iterations)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 41, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "sum(k6_iterations_total)",
          "legendFormat": "Iterations",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null }
            ]
          },
          "noValue": "0"
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value",
        "colorMode": "none"
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 35,
      "title": "⚡ Live Bookings/s",
      "type": "stat",
      "gridPos": { "x": 16, "y": 41, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "sum(rate(showbee_booking_requests_total[30s]))",
          "legendFormat": "Bookings/s",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          },
          "unit": "reqps",
          "noValue": "0",
          "custom": { "fontSize": 28 }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 36,
      "title": "❌ Failure Rate %",
      "type": "gauge",
      "gridPos": { "x": 20, "y": 41, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "clamp_max(sum(rate(showbee_http_errors_total[30s])) / (sum(rate(showbee_http_requests_total[30s])) + 0.001) * 100, 100)",
          "legendFormat": "Failure %",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          },
          "noValue": "0"
        }
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 37,
      "title": "⏱ Response p50",
      "type": "stat",
      "gridPos": { "x": 0, "y": 45, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(showbee_http_request_duration_seconds_bucket[30s])) by (le))",
          "legendFormat": "p50",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          },
          "noValue": "N/A"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 38,
      "title": "⏱ Response p95",
      "type": "stat",
      "gridPos": { "x": 4, "y": 45, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(showbee_http_request_duration_seconds_bucket[30s])) by (le))",
          "legendFormat": "p95",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "noValue": "N/A"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 39,
      "title": "⏱ Response p99",
      "type": "stat",
      "gridPos": { "x": 8, "y": 45, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(showbee_http_request_duration_seconds_bucket[30s])) by (le))",
          "legendFormat": "p99",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 8 }
            ]
          },
          "noValue": "N/A"
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "id": 40,
      "title": "📈 VU Staircase Graph — Active VUs & Booking RPS",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 45, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(k6_vus)",
          "legendFormat": "Active VUs",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        },
        {
          "expr": "sum(rate(showbee_booking_requests_total[30s]))",
          "legendFormat": "Booking RPS",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "axisPlacement": "auto",
            "lineWidth": 2
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Booking RPS" },
            "properties": [
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "unit", "value": "reqps" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Active VUs" },
            "properties": [
              { "id": "custom.axisPlacement", "value": "left" },
              { "id": "unit", "value": "short" }
            ]
          }
        ]
      },
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    }
  ]
}
